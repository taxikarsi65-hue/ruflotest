# Скопируй этот файл в файл ".env" и впиши свои значения.
# Команда для копирования (из папки telegram-assistant-bot): cp env.sample .env

# Токен бота, который выдаёт @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Твой личный Telegram ID (узнать у @userinfobot) — бот будет отвечать ТОЛЬКО тебе
ALLOWED_USER_ID=

# Ключ OpenAI (https://platform.openai.com/api-keys) — нужен для распознавания
# голосовых сообщений и определения калорий по фото
OPENAI_API_KEY=

# Необязательно: путь к файлу базы данных (по умолчанию data/bot.db)
DATABASE_PATH=data/bot.db
